<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- This file shows all options for FCStatDef, and explains what they do and their default values -->
  <!-- FCStatDefs are named stats that policies, buildings, and events can modify via FCStatModifier entries. -->
  <!-- They are referenced by defName in XML and resolved at load time - typos will produce XML errors at startup. -->
  <FactionColonies.FCStatDef>
	<defName>myCustomStat</defName>
	<label>My Custom Stat</label>
	<description>A brief description of what this stat represents.</description>
	<!-- How multiple modifiers combine:
	     Additive: all values are summed together
	     Multiplicative: all values are multiplied together
	     Default: Additive -->
	<aggregation>Additive</aggregation>
	<!-- Whether this stat applies at the settlement level (propagated to settlements).
	     If false, it's faction-level only. Default: true -->
	<appliesToSettlements>true</appliesToSettlements>
	<!-- Translation key for the stat description displayed in UI (e.g. "FCTraitDesc_MilitaryLevel").
	     The translation string receives the formatted bonus value as its first argument. -->
	<descriptionKey>your translation key here</descriptionKey>
	<!-- If true, lower values are considered "better" for UI coloring purposes (e.g. costs, losses).
	     Default: false -->
	<invertedForDisplay>false</invertedForDisplay>
	<!-- If non-zero, the raw stat value is divided by this before display.
	     Used for tick-based stats (e.g. 2500 to convert ticks to in-game hours). Default: 0 (no division) -->
	<displayDivisor>0</displayDivisor>
	<!-- If non-null, this stat is a resource production stat linked to the given ResourceTypeDef.
	     When linked, the stat description uses the resource name and icon instead of the generic descriptionKey.
	     Only set this if you are defining production stats for a custom ResourceTypeDef. -->
	<linkedResource>defName of a ResourceTypeDef, or omit entirely</linkedResource>
  </FactionColonies.FCStatDef>


  <!-- FCStatModifier - not a Def, but a helper class used in many defs' statModifiers lists. -->
  <!-- It appears on: BuildingFCDef, FCEventDef, FCPolicyDef, WorldSettlementDef, -->
  <!-- BiomeResourceDef, TileMutatorResourceExtension, and TileLandmarkResourceExtension. -->
  <!-- Each entry is a {stat, value} pair that modifies the referenced FCStatDef. -->
  <!--
  Example usage inside another def's <statModifiers> list:
  <statModifiers>
      <li>
          <stat>myCustomStat</stat>
          <value>5</value>
      </li>
      <li>
          <stat>taxBasePercentage</stat>
          <value>0.1</value>
      </li>
  </statModifiers>
  -->

</Defs>
