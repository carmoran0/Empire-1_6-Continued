<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- This file shows all options for FCEventDef, and explains what they do and their default values -->
  <!-- FCEventDefs define events in the Empire mod. They can be scripted events (triggered by code) -->
  <!-- or random events (selected by the random event system based on conditions). -->
  <!-- Random events are the same def type with isRandomEvent set to true. -->
  <FactionColonies.FCEventDef>
	<defName>exampleEvent</defName>
	<label>Example Event</label>

	<!-- *=*=* Core Fields *=*=* -->
	<!-- Description shown in the event notification. -->
	<desc>Description of what happened in this event.</desc>
	<!-- The event category, which controls the UI accent color. References an FCEventCategoryDef. -->
	<category>EC_Other</category>
	<!-- Time in ticks until the event triggers/resolves. -1 means it triggers immediately. Default: -1 -->
	<timeTillTrigger>60000</timeTillTrigger>
	<!-- Maximum duration in ticks. If greater than timeTillTrigger, the actual duration is
	     randomized between the two values. The player sees a range, not the exact end time.
	     Default: -1 (no variable duration, uses exact timeTillTrigger). -->
	<timeTillTriggerMax>120000</timeTillTriggerMax>

	<!-- *=*=* Random Event Configuration *=*=* -->
	<!-- Set to true if this event should be eligible for random selection. Default: false -->
	<isRandomEvent>false</isRandomEvent>
	<!-- Controls when the options window is shown for events that have options.
	     If true: options are presented immediately when the event is created (the event is consumed
	     and not tracked in the events list). If false: options are shown when the event timer expires
	     (normal resolution flow). Also makes the event appear in the per-event disable list in
	     mod settings. Default: false -->
	<activateAtStart>false</activateAtStart>
	<!-- Minimum player wealth required for this random event to fire. Default: 0 -->
	<requiredWealth>0</requiredWealth>
	<!-- How many settlements this event affects. (0, 0) means it's faction-wide, not settlement-specific.
	     The actual number is randomly chosen within this range. Default: (0, 0) -->
	<rangeSettlementsAffected>(0, 0)</rangeSettlementsAffected>
	<!-- If true, all settlements are affected (overrides rangeSettlementsAffected). Default: false -->
	<targetAllSettlements>false</targetAllSettlements>
	<!-- If true, affected settlements carry over to follow-up events. Default: true -->
	<settlementsCarryOver>true</settlementsCarryOver>
	<!-- Weight for random selection - higher weight = more likely to be picked. Default: 0 -->
	<weight>10</weight>
	<!-- Stat range requirements for the random event to fire. -->
	<!-- The event will only fire if the faction's average stats fall within these ranges. -->
	<minimumHappiness>0</minimumHappiness>
	<maximumHappiness>100</maximumHappiness>
	<minimumLoyalty>0</minimumLoyalty>
	<maximumLoyalty>100</maximumLoyalty>
	<minimumUnrest>0</minimumUnrest>
	<maximumUnrest>100</maximumUnrest>
	<minimumProsperity>0</minimumProsperity>
	<maximumProsperity>100</maximumProsperity>
	<!-- If set, at least one settlement must be producing this resource for the event to fire. -->
	<requiredResource>RTD_Food</requiredResource>
	<!-- Settlement type allowlist (WorldSettlementDef defNames). If non-empty, only settlements whose type
	     matches an entry (or inherits from one via baseSettlementType) are eligible. Uses depth-based
	     resolution: if both allow and block lists match, the most specific (shallowest depth) wins;
	     ties go to block. -->
	<allowedSettlementTypes>
		<li>WorldSettlementDef_Surface</li>
	</allowedSettlementTypes>
	<!-- Settlement type blocklist. Settlements whose type matches (or inherits from) an entry are excluded.
	     Can coexist with allowedSettlementTypes; depth-based resolution handles conflicts. -->
	<blockedSettlementTypes>
		<li>WorldSettlementDef_Orbital</li>
	</blockedSettlementTypes>
	<!-- Events that cannot be active at the same time as this one. -->
	<incompatibleEvents>
		<li>anotherEvent</li>
	</incompatibleEvents>
	<!-- Tech level range for this event to be eligible. Uses TechLevel enum values. -->
	<!-- Undefined (default) means no restriction. Checked against FactionFC.techLevel, -->
	<!-- which is automatically clamped when medievalTechOnly is enabled. -->
	<minTechLevel>Industrial</minTechLevel>
	<maxTechLevel>Spacer</maxTechLevel>
	<!-- All listed research projects must be completed for this event to fire. -->
	<requiredResearch>
		<li>Electricity</li>
		<li>Machining</li>
	</requiredResearch>
	<!-- Minimum ticks after this event resolves before it can fire again. 0 = no cooldown.
	     Example: 600000 = 10 in-game days. Default: 0 -->
	<cooldownTicks>0</cooldownTicks>
	<!-- Maximum number of times this event can fire in a playthrough. -1 = unlimited. Default: -1 -->
	<maxFireCount>-1</maxFireCount>
	<!-- Minimum faction settlements required for eligibility.
	     Independent from rangeSettlementsAffected (which controls targeting). Default: 0 -->
	<minSettlements>3</minSettlements>
	<!-- Event only fires if this policy, trait, or edict is active. References FCPolicyDef defName. -->
	<requiredPolicy>militaristic</requiredPolicy>
	<!-- Minimum days since faction founding. 1 day = 60,000 ticks. Default: 0 -->
	<minDaysSinceFounded>30</minDaysSinceFounded>

	<!-- *=*=* Options *=*=* -->
	<!-- If this event presents choices to the player, list the FCOptionDefs here. -->
	<!-- See FCOptionDef.xml for details. -->
	<options>
		<li>exampleOption1</li>
		<li>exampleOption2</li>
	</options>
	<!-- Optional description shown in the options window. If empty, falls back to desc. -->
	<optionDescription>Choose how to respond to this event.</optionDescription>

	<!-- *=*=* Event Chains *=*=* -->
	<!-- If true, another event follows after this one resolves. Default: false -->
	<eventFollows>false</eventFollows>
	<!-- The event that follows this one. Only used if eventFollows is true. -->
	<followingEvent>followUpEvent</followingEvent>
	<!-- An alternative follow-up event (used with splitEventFollows). -->
	<followingEvent2>alternativeFollowUpEvent</followingEvent2>
	<!-- If true, there's a random chance to follow either followingEvent or followingEvent2. Default: false -->
	<splitEventFollows>false</splitEventFollows>
	<!-- Percent chance (0-100) to follow followingEvent. The remainder goes to followingEvent2. Default: 50 -->
	<splitEventChance>50</splitEventChance>

	<!-- *=*=* Rewards *=*=* -->
	<!-- Specific ThingDefs to give as loot when this event resolves. -->
	<loot>
		<li>Silver</li>
	</loot>
	<!-- Base market value for randomly generated reward items. 0 means no random rewards. Default: 0 -->
	<randomThingValue>500</randomThingValue>
	<!-- References a ResourceEventRewardDef that controls how random rewards are generated. -->
	<!-- See ResourceEventRewardDef.xml for details. -->
	<randomThingRewardDef>defNameOfRewardDef</randomThingRewardDef>
	<!-- Prosperity lost when this event resolves. Default: 0 -->
	<prosperityLost>0</prosperityLost>
	<!-- Biome allowlist (BiomeDef defNames). If non-empty, only settlements in these biomes are eligible. -->
	<applicableBiomes>
		<li>BorealForest</li>
	</applicableBiomes>
	<!-- Biome blocklist (BiomeDef defNames). Settlements in these biomes are excluded. Ignored if applicableBiomes is set. -->
	<restrictedBiomes>
		<li>Desert</li>
		<li>ExtremeDesert</li>
	</restrictedBiomes>

	<!-- *=*=* Stat Modifiers *=*=* -->
	<!-- Stat modifiers applied while this event is active. Removed when the event resolves. -->
	<!-- See FCStatDef.xml for details on FCStatModifier. -->
	<statModifiers>
		<li>
			<stat>happinessLostBase</stat>
			<value>5</value>
		</li>
	</statModifiers>
	<!-- Permanent stat modifiers applied to affected settlements. Unlike statModifiers, these persist
	     after the event resolves and remain on the settlement permanently. -->
	<permanentStatModifiers>
		<li>
			<stat>taxBasePercentage</stat>
			<value>0.05</value>
		</li>
	</permanentStatModifiers>

	<!-- *=*=* Settlement Selection *=*=* -->
	<!-- If true, random settlement selection uses proximity-based weighting (closer settlements more likely). Default: true -->
	<useProximity>true</useProximity>
	<!-- Falloff distance for proximity weighting. Higher values make distance matter less. Default: 20 -->
	<proximityFalloff>20</proximityFalloff>

	<!-- *=*=* Classification *=*=* -->
	<!-- If true, this event involves military combat (e.g. settlement attacks). Default: false -->
	<isMilitaryEvent>false</isMilitaryEvent>
	<!-- If true, this event is classified as negative (for UI and behavioral purposes). Default: false -->
	<isNegative>false</isNegative>

	<!-- *=*=* Mod Extensions *=*=* -->
	<!-- FCEventHandlerExtension: provides custom event resolution logic. -->
	<!-- Extend FCEventHandlerExtension and override ResolveEvent() and/or OnEventTriggered(). -->
	<!-- ResolveEvent() is called when the event triggers - return true to skip built-in resolution. -->
	<!-- OnEventTriggered() is called after all standard processing (loot, stats, cascading events). -->
	<!-- <modExtensions>
		<li Class="YourNamespace.YourEventHandlerExtension" />
	</modExtensions> -->
  </FactionColonies.FCEventDef>

</Defs>
